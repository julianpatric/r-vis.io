{
  "name": "r-vis.io",
  "version": "0.2.0",
  "private": true,
  "dependencies": {
    "@opennextjs/cloudflare": "^1.3.0",
    "@sanity/client": "^6.28.1",
    "lenis": "^1.1.22",
    "motion": "^12.4.9",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-youtube": "^10.1.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-sitemap.js && next build",
    "cf:build": "node scripts/generate-sitemap.js && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "next lint",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "wrangler": "^4.68.0"
  }
}
